# Copy this file to .env and fill in your keys
# Never commit .env to git

SUPABASE_URL=https://mvrmcptahvwmfvnwlvyd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Apify — primary transcript source (~$0.001/video). Without this, transcripts
# use the free local chain (yt-dlp -> timedtext -> AssemblyAI), home IP only.
# Sign up at https://apify.com (no card needed) -> Settings -> API tokens.
APIFY_TOKEN=your_apify_token_here

# Google AI Studio key — Gemini summaries, storylines and search embeddings (paid tier)
# Get it at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional - only needed if YouTube transcripts are unavailable (home IP only:
# the local fallback chain, including this audio path, is skipped on GitHub Actions)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Optional - local fallback only. Fresh YouTube cookies read from an installed
# browser at run time (chrome, firefox, safari, edge), or a Netscape cookies.txt:
# YOUTUBE_BROWSER=chrome
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# Optional - caption languages Apify may return, in order (bare ISO codes).
# Default en,hi; the first match wins, so English channels are unaffected.
# APIFY_CAPTION_LANGUAGES=en,hi

# Optional - set to 1 to try the local fallback chain on GitHub Actions too
# (it is skipped there: YouTube blocks datacenter IPs).
# TRANSCRIPT_LOCAL_FALLBACK_IN_CI=1
