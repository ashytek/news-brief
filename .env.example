# Copy this file to .env.local and fill in your keys
# Never commit .env.local to git

NEXT_PUBLIC_SUPABASE_URL=https://mvrmcptahvwmfvnwlvyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Used server-side by app/api/search/route.ts for query embeddings.
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Used server-side by app/api/pipeline/trigger/route.ts to dispatch the
# news-pipeline.yml GitHub Actions workflow on demand ("Run now" button).
# Create a fine-grained PAT scoped to ONLY the ashytek/news-brief repo,
# with the "Actions" permission set to Read and write — nothing else needed.
# GitHub Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens.
GITHUB_PIPELINE_PAT=your_github_fine_grained_pat_here
